{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**/*.astro",
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"!**/.astro",
			"!**/.beads",
			"!**/dist",
			"!**/node_modules",
			"!**/package-lock.json",
			"!**/pnpm-lock.yaml",
			"!**/package.json",
			"!**/.vscode",
			"!**/tsconfig.json",
			"!**/.claude/settings.local.json",
			"!**/src/data/blog/_admin",
			"!**/src/data/blog/.obsidian",
			"!**/scripts"
		]
	},
	"formatter": {
		"enabled": true,
		"includes": ["**", "!**/*.astro"],
		"attributePosition": "multiline",
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 90
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"arrowParentheses": "always",
			"attributePosition": "multiline",
			"bracketSameLine": true,
			"bracketSpacing": true,
			"jsxQuoteStyle": "single",
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		},
		"globals": ["Astro"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {},
			"complexity": {},
			"correctness": {},
			"nursery": {
				"useExplicitType": "off"
			},
			"performance": {},
			"security": {
				"noSecrets": "off"
			},
			"style": {
				"noDefaultExport": "off",
				"useBlockStatements": "off",
				"useConsistentArrayType": {
					"level": "warn",
					"options": {
						"syntax": "generic"
					}
				},
				"useFilenamingConvention": "off",
				"useNamingConvention": "off",
				"noProcessEnv": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"noReactSpecificProps": "off"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"defaultBranch": "main",
		"enabled": true
	}
}
