---
import type { HTMLAttributes } from "astro/types";

export type Props = Omit<HTMLAttributes<"a">, "href"> & {
  href: string;
  className?: string;
};

const { href, className, ...anchorProps } = Astro.props;
---

<a href={href} {...anchorProps} class:list={["hover:opacity-75", className]}>
  <slot />
</a>
