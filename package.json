{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup": "npm run corepack",
    "corepack": "corepack enable pnpm",
    "post:new": "node scripts/create-post.ts",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "rm -rf dist && astro build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "wrangler dev",
    "preview:local": "astro preview",
    "check": "pnpm check:astro && pnpm check:biome",
    "check:astro": "astro check",
    "check:biome": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "astro": "astro"
  },
  "dependencies": {
    "@ascorbic/feed-loader": "2.0.1",
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/react": "6.0.6",
    "@astrojs/rss": "4.0.19",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "@extractus/feed-extractor": "7.2.1",
    "@extractus/oembed-extractor": "4.1.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource/poppins": "5.3.0",
    "@iconify-json/lucide": "1.2.147",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "astro": "7.4.2",
    "astro-expressive-code": "0.44.2",
    "astro-icon": "1.2.0",
    "astro-og": "0.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ofetch": "1.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "remark-directive": "4.0.0",
    "rss-parser": "3.13.0",
    "sanitize-html": "2.18.1",
    "tailwind-gradient-mask-image": "1.2.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unist-util-visit": "5.1.0",
    "vite-plugin-simple-scope": "3.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@vitest/browser": "4.1.12",
    "@vitest/ui": "4.1.12",
    "happy-dom": "20.14.6",
    "jsdom": "27.4.0",
    "lefthook": "2.2.2",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
